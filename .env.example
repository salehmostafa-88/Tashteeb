# Contract only. Copy to .env.local for local development; never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Temporary working name (owner decision O05); not baked into code.
NEXT_PUBLIC_PRODUCT_NAME=Studio Portal
# From `pnpm db:start` output (local Supabase). The publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never NEXT_PUBLIC; restricted background jobs only, not ordinary requests.
SUPABASE_SERVICE_ROLE_KEY=
# Local migration/test connection only. Do not commit real credentials.
DATABASE_URL=
# Optional production adapters; configure only when approved.
EMAIL_PROVIDER_API_KEY=
ERROR_MONITORING_DSN=
# No real billing secrets until the provider and launch are approved.
BILLING_WEBHOOK_SECRET=
